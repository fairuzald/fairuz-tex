@article{shaoIntentTaxonomyLegal2024,
  title = {An {{Intent Taxonomy}} of {{Legal Case Retrieval}}},
  author = {Shao, Yunqiu and Li, Haitao and Wu, Yueyue and Liu, Yiqun and Ai, Qingyao and Mao, Jiaxin and Ma, Yixiao and Ma, Shaoping},
  date = {2024-03-31},
  journaltitle = {ACM Trans. Inf. Syst.},
  volume = {42},
